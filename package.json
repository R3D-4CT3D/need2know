{
  "name": "need2know",
  "version": "0.4.0",
  "private": true,
  "description": "What Sites See: a cross-browser extension that catches websites fingerprinting you in real time.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "icons": "node scripts/make-icons.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node test/e2e.mjs",
    "lint:firefox": "npm run build:firefox && npx -y web-ext lint --source-dir dist/firefox",
    "crawl": "node scripts/crawl.mjs",
    "crawl:report": "node scripts/crawl-report.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fingerprintjs/fingerprintjs": "5.3.0",
    "playwright-core": "1.63.0"
  }
}
